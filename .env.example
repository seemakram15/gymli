# ── Supabase (public — safe in browser) ──────────────────────────────────────
# Supabase → Project Settings → API
# Also add these in Vercel → Project Settings → Environment Variables (Production + Preview)
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (private — server-side only) ────────────────────────────────────
# Supabase → Project Settings → API → service_role key
# Add in Vercel as a server-only env var (not prefixed with PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Brevo (Sendinblue) — for transactional email ─────────────────────────────
# Brevo → SMTP & API → SMTP tab
BRAVO_SMTP_KEY=your-smtp-password-here
SMTP_SERVER=smtp-relay.brevo.com
PORT=587
LOGIN=your-brevo-login@smtp-brevo.com
# Brevo → SMTP & API → API Keys tab
BRAVO_API_KEY=your-api-key-here
BRAVO_EMAIL=your-sender-email@domain.com
